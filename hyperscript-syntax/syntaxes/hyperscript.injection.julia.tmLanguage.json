{
  "scopeName": "hyperscript.injection.julia",
  "injectionSelector": "L:source.julia",
  "patterns": [
    { "include": "#hyperscript-assign" },
    { "include": "#hyperscript-macro" }
  ],
  "repository": {

    "hyperscript-assign": {
      "comment": "Matches _=\"...\" and _='...' in Julia source",
      "patterns": [
        {
          "comment": "Double-quoted: allow single-quoted strings inside, not double",
          "name": "meta.embedded.hyperscript",
          "begin": "(_)\\s*=\\s*\"",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.hyperscript" }
          },
          "contentName": "source.hyperscript",
          "patterns": [
            { "include": "source.hyperscript#comment" },
            { "include": "source.hyperscript#string-single" },
            { "include": "source.hyperscript#number" },
            { "include": "source.hyperscript#constant" },
            { "include": "source.hyperscript#control" },
            { "include": "source.hyperscript#command" },
            { "include": "source.hyperscript#reference" },
            { "include": "source.hyperscript#event" },
            { "include": "source.hyperscript#selector" },
            { "include": "source.hyperscript#operator" }
          ]
        },
        {
          "comment": "Single-quoted: allow double-quoted strings inside, not single",
          "name": "meta.embedded.hyperscript",
          "begin": "(_)\\s*=\\s*'",
          "end": "'",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.hyperscript" }
          },
          "contentName": "source.hyperscript",
          "patterns": [
            { "include": "source.hyperscript#comment" },
            { "include": "source.hyperscript#string-double" },
            { "include": "source.hyperscript#number" },
            { "include": "source.hyperscript#constant" },
            { "include": "source.hyperscript#control" },
            { "include": "source.hyperscript#command" },
            { "include": "source.hyperscript#reference" },
            { "include": "source.hyperscript#event" },
            { "include": "source.hyperscript#selector" },
            { "include": "source.hyperscript#operator" }
          ]
        }
      ]
    },

    "hyperscript-macro": {
      "comment": "Matches _\"...\" and _\"\"\"...\"\"\" Julia string macros — only double-quoted so allow single inside",
      "patterns": [
        {
          "name": "meta.embedded.hyperscript",
          "begin": "\\b(_)\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": { "name": "support.function.macro.hyperscript" }
          },
          "contentName": "source.hyperscript",
          "patterns": [
            { "include": "source.hyperscript#comment" },
            { "include": "source.hyperscript#string-single" },
            { "include": "source.hyperscript#number" },
            { "include": "source.hyperscript#constant" },
            { "include": "source.hyperscript#control" },
            { "include": "source.hyperscript#command" },
            { "include": "source.hyperscript#reference" },
            { "include": "source.hyperscript#event" },
            { "include": "source.hyperscript#selector" },
            { "include": "source.hyperscript#operator" }
          ]
        },
        {
          "name": "meta.embedded.hyperscript",
          "begin": "\\b(_)\"",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "support.function.macro.hyperscript" }
          },
          "contentName": "source.hyperscript",
          "patterns": [
            { "include": "source.hyperscript#comment" },
            { "include": "source.hyperscript#string-single" },
            { "include": "source.hyperscript#number" },
            { "include": "source.hyperscript#constant" },
            { "include": "source.hyperscript#control" },
            { "include": "source.hyperscript#command" },
            { "include": "source.hyperscript#reference" },
            { "include": "source.hyperscript#event" },
            { "include": "source.hyperscript#selector" },
            { "include": "source.hyperscript#operator" }
          ]
        }
      ]
    }

  }
}
